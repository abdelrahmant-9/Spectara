{
  "manifest_version": 3,
  "name": "Smart Selenium Locator Generator",
  "short_name": "Smart Selenium",
  "version": "1.3.0",
  "version_name": "1.3.0",
  "description": "Generate stable Selenium locators, Java snippets, and Page Object Model classes from any web element — in one click.",
  "minimum_chrome_version": "116",
  "author": "Abdelrahman Tarek",
  "homepage_url": "https://github.com/abdelrahmant-9/smart-selenium-locator-generator",

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Smart Selenium Locator Generator",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "utils/xpathGenerator.js",
        "utils/cssGenerator.js",
        "utils/locatorPriority.js",
        "utils/codeGenerator.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Smart Selenium Locator Generator"
    }
  },

  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
